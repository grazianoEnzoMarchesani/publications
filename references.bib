@article{
	11581_466312,
	author = {COCCI GRIFONI, Roberta and Ottone, Maria Federica and Riera, Dajla and Marchesani, Graziano Enzo and Romanella, Davide},
	title = {GREEN INFRASTRUCTURE FOR INTERMEDIATE CITIES - THE ASCOLI PICENO CASE STUDY  (Rivista Classe A).},
	year = {2022},
	journal = {ABITARE LA TERRA},
	abstract = {The urban spaces of Ascoli Piceno now require a conscious reorganisation. As other cities that are depopulating the activities need to be relocated, to add the performance and aesthetic qualities necessary to bring aback residents and activities. The new use of urban spaces requires decision-making processes involving politics, productive economy, culture and social consumption, all referring to more collegial choices and guidelines outlining the transformation processes to improve urban health and quality of life. The energy-environmental strategy for the urban regeneration of Ascoli Piceno has allowed the increase of the area's permeability by more than 25%, and the presence of urban green of 24%, implementing the process of mitigation and adaptation to climate change and decreasing the temperature in the hottest summer scenarios and the central hours of the day by about 8 °C. This improves the perception of environmental comfort of users and the quality of life considerably.},
	pages = {76--79},
	number = {n. 7-8}
}
